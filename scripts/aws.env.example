# Copy to scripts/aws.env and fill in (scripts/aws.env is git-ignored)
AWS_REGION=eu-west-2

# RDS DB identifier (RDS console → Databases → "DB identifier" column)
DB_ID=trainers-db1

# EC2 instance ID (EC2 console → Instances → "Instance ID", e.g. i-0abc123...)
EC2_ID=i-xxxxxxxxxxxxxxxxx

# CloudFront distribution ID (CloudFront console → "ID", e.g. E1ABCDEF...)
CF_DISTRIBUTION_ID=EXXXXXXXXXXXXX
# The Origin ID you gave the EC2 origin in CloudFront (Origins tab → "Origin name")
CF_EC2_ORIGIN_ID=ec2-api

# Private S3 bucket that holds the built frontend
SITE_BUCKET=dhrey-trainers-site

# Path to the frontend project on your Mac
FRONTEND_DIR=$HOME/node-backend/trainers-frontend
