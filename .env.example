# Copy to .env on EC2 and fill in your RDS details
DB_HOST=your-db.xxxxxxxx.eu-west-2.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your-password
DB_NAME=trainers-db1
PORT=3000
CORS_ORIGIN=*
S3_BASE_URL=https://dhrey-store-v3.s3.eu-west-2.amazonaws.com
# Behind Nginx: only listen locally so port 3000 is not exposed
HOST=127.0.0.1
# Required header (x-admin-key) for adding trainers via POST /products
ADMIN_KEY=change-me-to-a-long-random-string
